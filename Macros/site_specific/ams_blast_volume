######################################################################
#
# Macro Name    : ams_blast_volume.tcl
#
# Version       : Surpac 7.2 (x64)
#
# Creation Date : Tue Jun 9 2026
#
# Author        : Alby Palmer
#
# Site          : Buzzard
#
# Description   : Generate blast solid and calculate volume from survey pickup
#                 Assumes boundary string and blast holes in same layer
#
######################################################################

# Notes / improvements
# hide other layers (if STR file is already loaded, we want that hidden)
# check if boundary string exists

puts "Macro running"

# Define hole strings and boundary string numbers - update as required for site
array set holeStrings {
    presplit 103
    lostGet 105
    bviPre 106
    bviPost 107
    production 108
}

set boundaryString 109

set allshotDescString 20

set strings {}
foreach {key val} [array get holeStrings] {
	lappend strings $val
}

set strings [join $strings ";"]

set pit ""
set rl ""
set shot ""

set strFiles [glob -nocomplain {*.str}]

if {[llength $strFiles] == 1} {
    puts "Found 1 string file."

    set cleanName [file rootname [lindex $strFiles 0]]
    set details [split $cleanName _]
    
    if {[llength $details] == 3} {
        lassign $details pit rl shot
        
        puts [format "Variables set -> Pit: %s, RL: %s, Shot: %s" $pit $rl $shot]
    } else {
        puts "Warning: File does not have exactly 3 parts."
    }
}

set form [subst {
  GuidoForm form {
    -label "Process blast solid and volume"
    -default_buttons
    -defaults_key sectionsfile
    -layout BoxLayout Y_AXIS
    -width 45
    -height 18

    GuidoPanel panel_left {
      -layout BoxLayout Y_AXIS

      GuidoPanel panel_1 {
        -label "Survey pickup"
        -layout CentreLineLayout
        -border etched true

        GuidoFileBrowserField pickupFile {
          -label "Select blast pickup file"
          -format none
          -translate none
          -default "[lindex $strFiles 0]"
          -file_mask "*.str"
          -display_length 20
          -extension false
        }

        GuidoField benchElevation {
          -label "Floor elevation"
          -format none
          -null false
          -default "$rl"
        }

        GuidoField boundaryStringField {
          -label "Boundary string number"
          -default "$boundaryString"
          -null false
        }

        GuidoField holeStringsField {
          -label "Hole string numbers (range or semicolon separated)"
          -default "$strings"
          -width 20
        }
      }

      GuidoPanel panel_2 {
        -label "<html>Design input<br><font color='red'>Input design file <b>ONLY</b> for wall/ramp clipping</html>"
        -layout CentreLineLayout
        -border etched true

        GuidoFileBrowserField designFile {
          -label "Select design file"
          -file_mask "*.dtm"
          -display_length 20
        }
      }

      GuidoPanel panel_3 {
        -label "Settings"
        -layout CentreLineLayout
        -border etched true

        GuidoCheckBox updateAllshot {
          -label "Update Survey Allshot strings/dxf"
          -caption "Yes"
          -selected_value "y"
          -unselected_value "n"
          -default "y"
        }

        GuidoCheckBox delTemp {
          -label "Delete temporary files"
          -caption "Yes"
          -selected_value "y"
          -unselected_value "n"
          -default "y"
        }
      }
      
      GuidoLabel label2 {
        -label "<html><font color='red'>Note: Hole strings must be in same layer as boundary string</font color><br><br>
        If wall/ramp shot, input design file, otherwise leave blank.<br>
        Update Survey Allshot - updates the ###_allshots* files</html>"
      }
    }
  }
}]

SclCreateGuidoForm mainForm $form {}

$mainForm SclRun {}
if {$_status == "cancel"} {
    puts "Macro cancelled by user"
    return
}

set sfx    _vol
set output $pickupFile$sfx

# Create DTM from pickup STR
set status [ SclFunction "CREATE DTM" {
  frm00126={
    {
      location="$pickupFile"
      object_num="1"
      obj_name=""
      inputExt="str"
      output_fname="$output"
      plane="plan"
      check_distance="0.0050"
      break="Y"
      anyspots="Y"
      spotrng="$holeStringsField"
      brktest="N"
      interpolate_new_points="N"
      apply_boundary="Y"
      bdyloc="$pickupFile"
      bdystr="$boundaryStringField"
      inout="I"
    }
  }
}]

set status [ SclFunction "RECALL ANY FILE" {
  file="$output.dtm"
  mode="openInNewLayer"
}]

set status [ SclFunction "GRAPHICS LAYER MATHS" {
  frm00702={
    {
      strrange="Y"
      main=table { str_range constraint field expr } {
        { "" "" "z" "$benchElevation" }
        { "" "" "" "" }
        { "" "" "" "" }
        { "" "" "" "" }
        { "" "" "" "" }
        { "" "" "" "" }
        { "" "" "" "" }
        { "" "" "" "" }
        { "" "" "" "" }
        { "" "" "" "" }
      }
    }
  }
}]

set status [ SclFunction "RECALL ANY FILE" {
  file="$output.dtm"
  mode="appendToCurrentLayer"
}]

set status [ SclFunction "SECTION" {} ]

set status [ SclFunction "EDGES ON" {} ]

set top [SclSelectPoint pnt "Select top DTM" layer str_no seg_no pnt_no x1 y1 z1 desc]

set bot [SclSelectPoint pnt "Select bottom DTM" layer str_no seg_no pnt_no x2 y2 z2 desc]

set status [ SclFunction "TRIANGULATE AUTOMATIC" {
  frm00459={
    {
      iobj="1"
      itrisol="1"
    }
  }
  select_point=table { winx winy objectx objecty objectz snap_projection } {
    { "0.500" "0.000" "$x1" "$y1" "$z1" "off" }
    { "0.500" "0.000" "$x2" "$y2" "$z2" "off" }
  }
}]

set status [ SclFunction "PLAN" {} ]

set status [ SclFunction "ERASE OBJECTS" {
  frm00089={
    {
      range1="1"
      range2="1"
      range3=""
      textalignment="<"
      position="All points"
      layer_name="$output.dtm"
      display_object_number=""
      display_trisolation_number=""
    }
  }
}]

set status [ SclFunction "EDGES OFF" {} ]

set point [SclSelectPoint pnt "Select DTM" layer str_no seg_no pnt_no x y z desc]

set status [ SclFunction "TRISOLATION RENUMBER" {
  select_triangle={
    {
      winx="0.000"
      winy="0.000"
      objectx="$x"
      objecty="$y"
      objectz="$z"
    }
  }
  frm00453={
    {
      newobj="1"
      newtrisol="1"
    }
  }
}]

set status [ SclFunction "DRAW OBJECTS" {
  frm00089={
    {
      range1=""
      range2=""
      range3=""
      ifld_num="d1"
      textalignment="<"
      layer_name="$output.dtm"
      display_object_number="N"
    }
  }
}]

set status [ SclFunction "NEIGHBOURS AND VALIDATE OBJECT" {
  frmvalidateObject={
    {
      report_file=""
      obj_range=""
      trisol_range=""
      fix_problems="N"
      report_intersection_duplication="N"
      set_as_solid="Y"
      deleteSmallTrisol="N"
      deleteSmallTriangles="N"
      displayTriangleDir="N"
      colours=table { colour_label colour_field } {
        { "Holes" "GREEN" }
        { "Intersecting triangles" "CYAN" }
        { "Invalid edges only" "ORANGE" }
        { "Open edges" "MAGENTA" }
        { "Reversed triangles" "RED" }
      }
    }
  }
}]

set status [ SclFunction "FILE SAVE" {
  frmsaveFileAs={
    {
      output_file="$output"
      output_type="Surpac DTM Files"
      outputExt=".dtm"
      Surpac={
        range=""
        Purpose=""
        FileFormat="text"
        ForceCompatibility="true"
        ForceValidation="true"
      }
      saveStyle="N"
    }
  }
  frmSaveMultipleFiles={
    {
      _action="apply"
    }
  }
}]

if [info exists designFile] {
  set status [ SclFunction "TRISOLATION FILE 3DM/DTM ABOVE" {
    frm00714={
      {
        location1="$output.dtm"
        id1=""
        object1=""
        trisol1=""
        retain_other_trisolations="N"
        location2="$designFile"
        id2="31032026"
        object2="1"
        trisol2="1"
        result_location="$output.dtm"
        result_id=""
        use_first_object_id="N"
        result_object="1"
        contact_string="0"
      }
    }
    frm00121={
      {
        _action=""
      }
    }
  }]

  set status [ SclFunction "RECALL ANY FILE" {
    file="$output.dtm"
    mode="none"
  }]
}

set status [ SclFunction "OBJECT REPORT" {
  frm00466={
    {
      reploc="$output..not"
      repid=""
      report_format=".not"
      checkoverlaps="N"
      report_type="T"
      decimals="0"
    }
  }
}]

if {$updateAllshot == "y"} {
  # get folder path, split to relativePath used in bench directory (###rl) to load allshot layers
  set path [pwd]
  # regexp 3 digits followed by "rl" or "RL"
  if {[regexp -indices {\d{3}[rRlL]{2}} $path match_range]} {
    set start [lindex $match_range 0]
    set end [lindex $match_range 1]
    set matchFolder [string range $path $start $end]

    # Relative path
    set remaining [string range $path [expr {$end + 1}] end]
    set folderCount [llength [file split $remaining]]

    if {$folderCount > 0} {
        set dots [string repeat "../" $folderCount]
        set relativePath "${dots}${matchFolder}/"
      } else {
        set relativePath "./${matchFolder}/"
      }
    
    puts "Relative path: $relativePath"
  }

  set systemTime [clock seconds]

  set status [ SclFunction "RECALL ANY FILE" {
    file="$pickupFile.str"
    mode="openInNewLayer"
  }]

  # create point with shot details
  SclDigitise "Digitise point for Shot ID" xvar yvar zvar
  SclGetActiveViewport ViewportHandle
  $ViewportHandle SclGetActiveLayer SwaHandle
  $SwaHandle SclCreateString stringhandle $allshotDescString
  $stringhandle SclCreateSegment segmenthandle 0
  $segmenthandle SclCreatePoint pointhandle 0
  $pointhandle SclSetValueByName x $xvar
  $pointhandle SclSetValueByName y $yvar
  $pointhandle SclSetValueByName z $zvar
  $pointhandle SclSetValueByName d1 "$pickupFile"
  $pointhandle SclSetValueByName d2 "[clock format $systemTime -format %D]"
  $pointhandle SclSetValueByName d2 "[clock format $systemTime -format %D]"

  set status [ SclFunction "RECALL ANY FILE" {
    file="$relativePath${benchElevation}_allshots_survey.str"
    mode="appendToCurrentLayer"
  }]

  set status [ SclFunction "FILE SAVE" {
    frmsaveFileAs={
      {
        output_file="$relativePath${benchElevation}_allshots_survey"
        output_type="Surpac String Files"
        outputExt=".str"
        Surpac={
          range=""
          Purpose=""
          FileFormat="text"
          ForceValidation="true"
          ForceCompatibility="true"
        }
        saveStyle="N"
      }
    }
    frm00121={
      {
        _action=""
      }
    }
  }]

  # undo command to remove the recalled layer (revert back to pickup file)
  set status [ SclFunction "UNDO" {} ]

  set status [ SclFunction "RECALL ANY FILE" {
    file="$relativePath${benchElevation}_allshots.str"
    mode="appendToCurrentLayer"
  }]

  set status [ SclFunction "STRING DELETE RANGE" {
    frm00066={
      {
        strange="$holeStringsField"
      }
    }
  }]

  set status [ SclFunction "FILE SAVE" {
    frmsaveFileAs={
      {
        output_file="$relativePath${benchElevation}_allshots"
        output_type="Surpac String Files"
        outputExt=".str"
        Surpac={
          range=""
          Purpose=""
          FileFormat="text"
          ForceValidation="true"
          ForceCompatibility="true"
        }
        saveStyle="N"
      }
    }
    frm00121={
      {
        _action=""
      }
    }
  }]

  set status [ SclFunction "FILE SAVE" {
    frmsaveFileAs={
      {
        output_file="$relativePath${benchElevation}_allshots"
        output_type="Autocad DXF / DWG Files"
        outputExt=".dxf"
        AutoCAD={
          version="Autocad 24 (2010)"
        }
      }
    }
    frm00121={
      {
        _action=""
      }
    }
  }]

  puts "Updated allshot layers"
}

# Log the volume
set f [open "$output.not" r]
set content [read $f]
close $f
set trimmed [string trim $content]
set contentList [split $trimmed " "]
set lastElement [lindex $contentList end]
puts "${pickupFile} - Volume: ${lastElement}"

if {$delTemp == "y"} {  
  set status [ SclFunction "EXECUTE OS COMMAND" {
    frm00462={
      {
        os_cmd="del *.log"
      }
    }
  }]
}

puts "Macro finished"